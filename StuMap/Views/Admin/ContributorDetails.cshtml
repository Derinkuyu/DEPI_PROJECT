@model ContributorDetailsDto

@{
    ViewData["Title"] = "Contributor Details";
}

<div class="space-y-6">

    <!-- Back Button -->
    <div class="space-x-5">

        <a asp-action="ContributorRequests"
               asp-controller="Admin"
               class="inline-flex items-center gap-2 whitespace-nowrap text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content">

            Back to contributor requests

        </a>

    </div>

    <!-- Hero Section -->
    <div class="flex flex-col gap-6 rounded-[var(--radius-box)] border border-base-300 bg-base-200 p-6 lg:flex-row lg:items-start lg:justify-between">

        <!-- Left -->
        <div class="flex items-center gap-5">

            <!-- Contributor Info -->
            <div class="space-y-2">

                <h1 class="text-3xl font-bold text-base-content mb-1">
                    @Model.FullName
                </h1>

                <div class="space-y-1">

                    <p class="text-sm text-[var(--color-primary-content-para)]">
                        @@@(Model.Email.Split('@')[0])
                    </p>

                    <p class="text-sm text-[var(--color-primary-content-para)]">
                        @Model.Email
                    </p>

                </div>

                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-2 pt-1">

                    <span class="badge badge-primary px-4 py-3">
                        Contributor
                    </span>

                    <span class="badge badge-outline px-4 py-3">
                        @Model.Specialization
                    </span>

                    @if (Model.Status == ContributorStatus.Pending)
                    {
                        <span class="badge badge-warning px-4 py-3 text-black">
                            Pending
                        </span>
                    }
                    else if (Model.Status == ContributorStatus.Approved)
                    {
                        <span class="badge badge-success px-4 py-3 text-black">
                            Approved
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error px-4 py-3">
                            Rejected
                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-3">

            @if (Model.Status == ContributorStatus.Pending)
            {
                <a asp-action="ApproveContributor"
                       asp-controller="Admin"
                       asp-route-id="@Model.Id"
                       class="btn btn-success text-black">

                    Approve Contributor

                </a>

                <button class="btn btn-error"
                        onclick="document.getElementById('reject-modal').showModal()">
                    Reject Contributor
                </button>
            }

            <a href="@Model.CertificatePath"
                   target="_blank"
                   class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-primary-content">

                View Certificate

            </a>

        </div>

    </div>

    <!-- Contributor Information -->
    <div class="rounded-[var(--radius-box)] border border-base-300 bg-base-200 p-6 mb-3">

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between mb-3">

            <div>

                <h2 class="text-xl font-semibold text-base-content">
                    Contributor Information
                </h2>

                <p class="mt-1 text-sm text-[var(--color-primary-content-para)]">
                    Complete contributor account details and request metadata.
                </p>

            </div>

        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

            <!-- Email -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Email
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3 text-base-content">
                    @Model.Email
                </div>

            </div>

            <!-- Username -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Username
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3 text-base-content">
                    @@@(Model.Email.Split('@')[0])
                </div>

            </div>

            <!-- Phone -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Phone Number
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3 text-base-content">

                    @(string.IsNullOrEmpty(Model.PhoneNumber)
                        ? "Not Provided"
                        : Model.PhoneNumber)

                </div>

            </div>

            <!-- Specialization -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Specialization
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3 text-base-content">
                    @Model.Specialization
                </div>

            </div>

            <!-- Status -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Request Status
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3">

                    @if (Model.Status == ContributorStatus.Pending)
                    {
                        <span class="badge badge-warning text-black">
                            Pending
                        </span>
                    }
                    else if (Model.Status == ContributorStatus.Approved)
                    {
                        <span class="badge badge-success text-black">
                            Approved
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error">
                            Rejected
                        </span>
                    }

                </div>

            </div>

            <!-- Request Date -->
            <div class="space-y-2">

                <p class="text-sm font-medium text-[var(--color-primary-content-para)]">
                    Request Date
                </p>

                <div class="rounded-[var(--radius-field)] border border-base-300 bg-base-100 px-4 py-3 text-base-content">
                    @Model.RequestDate?.ToString("MMMM dd, yyyy")
                </div>

            </div>

        </div>

        <!-- Rejection Reason -->
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="mt-6 space-y-2">

                <p class="text-sm font-medium text-error">
                    Rejection Reason
                </p>

                <div class="rounded-[var(--radius-field)] border border-error bg-error/10 px-4 py-3 text-base-content">
                    @Model.RejectionReason
                </div>

            </div>
        }

    </div>

</div>

<!-- Reject Modal -->
<dialog id="reject-modal" class="modal">

    <div class="modal-box bg-base-200">

        <h3 class="text-lg font-bold mb-4">
            Reject Contributor Request
        </h3>

        <form asp-action="RejectContributor"
              asp-controller="Admin"
              method="post"
              class="space-y-4">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <textarea name="reason"
                      class="textarea textarea-bordered w-full"
                      placeholder="Enter rejection reason..."
                      required></textarea>

            <div class="modal-action">

                <button type="submit"
                        class="btn btn-error">
                    Reject
                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('reject-modal').close()">
                    Cancel
                </button>

            </div>

        </form>

    </div>

</dialog>
