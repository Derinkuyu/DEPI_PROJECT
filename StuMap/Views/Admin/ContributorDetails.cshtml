@model ContributorDetailsDto

@{
    ViewData["Title"] = "Contributor Details";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Back Button -->
    <div>

        <a asp-action="ContributorRequests"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 whitespace-nowrap text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content mb-2">

            <i class="fa-solid fa-arrow-left"></i>

            Back to contributor requests

        </a>

    </div>

    <!-- Hero Section -->
    <div class="flex flex-col gap-8 rounded-[var(--radius-box)] bg-base-200 p-8 lg:flex-row lg:items-start lg:justify-between">

        <!-- Left -->
        <div class="flex items-start gap-6">

            <!-- Contributor Info -->
            <div class="space-y-3">

                <h1 class="text-4xl font-bold tracking-tight text-base-content">

                    @Model.FullName

                </h1>

                <div class="space-y-1">

                    <p class="text-sm text-[var(--color-primary-content-para)]">

                        @@@(Model.Email.Split('@')[0])

                    </p>

                    <p class="text-sm text-[var(--color-primary-content-para)]">

                        @Model.Email

                    </p>

                </div>

                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-3 pt-3">

                    <span class="badge badge-primary px-4 py-3">

                        Contributor

                    </span>

                    <span class="badge badge-outline px-4 py-3">

                        @Model.Specialization

                    </span>

                    @if (Model.Status == ContributorStatus.Pending)
                    {
                        <span class="badge badge-warning px-4 py-3 text-black">

                            Pending

                        </span>
                    }
                    else if (Model.Status == ContributorStatus.Approved)
                    {
                        <span class="badge badge-success px-4 py-3 text-black">

                            Approved

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error px-4 py-3">

                            Rejected

                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 lg:justify-end">

            @if (Model.Status == ContributorStatus.Pending)
            {
                <a asp-action="ApproveContributor"
                   asp-controller="Admin"
                   asp-route-id="@Model.Id"
                   class="btn btn-success text-black">

                    Approve Contributor

                </a>

                <button class="btn btn-error"
                        onclick="document.getElementById('reject-modal').showModal()">

                    Reject Contributor

                </button>
            }

            <a href="@Model.CertificatePath"
               target="_blank"
               class="btn btn-outline btn-primary">

                View Certificate

            </a>

        </div>

    </div>

    <!-- Contributor Information -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-8">

        <!-- Header -->
        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">

                Contributor Information

            </h2>

            <p class="text-[var(--color-primary-content-para)] leading-7">

                Complete contributor account details and request metadata.

            </p>

        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">

            <!-- Email -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Email

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3 text-base-content">

                    @Model.Email

                </div>

            </div>

            <!-- Username -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Username

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3 text-base-content">

                    @@@(Model.Email.Split('@')[0])

                </div>

            </div>

            <!-- Phone -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Phone Number

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3 text-base-content">

                    @(string.IsNullOrEmpty(Model.PhoneNumber)
                        ? "Not Provided"
                        : Model.PhoneNumber)

                </div>

            </div>

            <!-- Specialization -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Specialization

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3 text-base-content">

                    @Model.Specialization

                </div>

            </div>

            <!-- Status -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Request Status

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3">

                    @if (Model.Status == ContributorStatus.Pending)
                    {
                        <span class="badge badge-warning text-black">

                            Pending

                        </span>
                    }
                    else if (Model.Status == ContributorStatus.Approved)
                    {
                        <span class="badge badge-success text-black">

                            Approved

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error">

                            Rejected

                        </span>
                    }

                </div>

            </div>

            <!-- Request Date -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Request Date

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-3 text-base-content">

                    @Model.RequestDate?.ToString("MMMM dd, yyyy")

                </div>

            </div>

        </div>

        <!-- Rejection Reason -->
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="pt-6 border-t border-base-300 space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-error">

                    Rejection Reason

                </p>

                <div class="rounded-[var(--radius-field)] bg-error/10 px-4 py-4 text-base-content leading-7">

                    @Model.RejectionReason

                </div>

            </div>
        }

    </div>

</section>

<!-- Reject Modal -->
<dialog id="reject-modal"
        class="modal">

    <div class="modal-box bg-base-200 p-8 space-y-6">

        <div class="space-y-2">

            <h3 class="text-2xl font-bold">

                Reject Contributor Request

            </h3>

            <p class="text-[var(--color-primary-content-para)]">

                Provide a clear reason for rejecting this contributor request.

            </p>

        </div>

        <form asp-action="RejectContributor"
              asp-controller="Admin"
              method="post"
              class="space-y-6">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <textarea name="reason"
                      class="textarea textarea-bordered w-full h-40"
                      placeholder="Enter rejection reason..."
                      required></textarea>

            <div class="modal-action">

                <button type="submit"
                        class="btn btn-error">

                    Reject

                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('reject-modal').close()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</dialog>