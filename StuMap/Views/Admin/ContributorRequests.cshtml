@model IEnumerable<ContributorRequestDto>

@{
    ViewData["Title"] = "Contributor Requests";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Header -->
    <div class="space-y-3">

        <h1 class="text-4xl font-bold tracking-tight text-base-content">

            Contributor Requests

        </h1>

        <p class="max-w-3xl text-lg leading-8 text-[var(--color-primary-content-para)]">

            Review contributor applications, verify certificates,
            and approve or reject contributor requests.

        </p>

    </div>

    <!-- Toolbar -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-6">

        <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">

            <!-- Left -->
            <div class="flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:items-center">

                <!-- Search -->
                <label class="input rounded-full bg-base-100 border-none w-full lg:w-[28rem] h-14 shadow-sm">

                    <svg class="h-[1em] opacity-50 mx-2"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24">

                        <g stroke-linejoin="round"
                           stroke-linecap="round"
                           stroke-width="2.5"
                           fill="none"
                           stroke="currentColor">

                            <circle cx="11"
                                    cy="11"
                                    r="8"></circle>

                            <path d="m21 21-4.3-4.3"></path>

                        </g>

                    </svg>

                    <input type="search"
                           placeholder="Search Contributors..."
                           class="border-none bg-transparent" />

                </label>

                <!-- Filters -->
                <div class="flex flex-wrap gap-3">

                    <!-- Specialization -->
                    <select class="select border-none bg-base-100 min-w-[12rem] shadow-sm">

                        <option selected disabled>

                            Specialization

                        </option>

                        <option>
                            Frontend
                        </option>

                        <option>
                            Backend
                        </option>

                        <option>
                            AI
                        </option>

                        <option>
                            Cybersecurity
                        </option>

                    </select>

                    <!-- Status -->
                    <select class="select border-none bg-base-100 min-w-[10rem] shadow-sm">

                        <option selected disabled>

                            Status

                        </option>

                        <option>
                            Pending
                        </option>

                        <option>
                            Approved
                        </option>

                        <option>
                            Rejected
                        </option>

                    </select>

                    <!-- Date -->
                    <select class="select border-none bg-base-100 min-w-[10rem] shadow-sm">

                        <option selected disabled>

                            Date

                        </option>

                        <option>
                            Newest
                        </option>

                        <option>
                            Oldest
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- Table Section -->
    <div class="rounded-[var(--radius-box)] bg-base-200 overflow-hidden">

        <!-- Table Header -->
        <div class="flex items-center justify-between px-6 py-5 border-b border-base-300">

            <div class="space-y-1">

                <h2 class="text-2xl font-semibold text-base-content">

                    All Contributor Requests

                </h2>

                <p class="text-sm text-[var(--color-primary-content-para)]">

                    Manage contributor approvals and application reviews.

                </p>

            </div>

            <div class="badge badge-primary badge-lg">

                @Model.Count() Requests

            </div>

        </div>

        <!-- Table -->
        <div class="overflow-x-auto">

            <table class="table">

                <!-- Head -->
                <thead>

                    <tr class="text-xs uppercase tracking-wider text-[var(--color-primary-content-para)]">

                        <th class="px-6 py-5">

                            <input type="checkbox"
                                   class="checkbox checkbox-sm" />

                        </th>

                        <th>

                            Contributor ↕

                        </th>

                        <th>

                            Email ↕

                        </th>

                        <th>

                            Specialization ↕

                        </th>

                        <th>

                            Status ↕

                        </th>

                        <th>

                            Request Date ↕

                        </th>

                        <th class="text-center">

                            Actions

                        </th>

                    </tr>

                </thead>

                <!-- Body -->
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-base-300/40 transition-colors">

                            <!-- Checkbox -->
                            <td class="px-6 py-5">

                                <input type="checkbox"
                                       class="checkbox checkbox-sm" />

                            </td>

                            <!-- Contributor -->
                            <td>

                                <div class="space-y-1">

                                    <div class="font-semibold text-base-content">

                                        @item.FullName

                                    </div>

                                    <div class="text-sm text-[var(--color-primary-content-para)]">

                                        @@@(item.Email.Split('@')[0])

                                    </div>

                                </div>

                            </td>

                            <!-- Email -->
                            <td class="text-sm text-[var(--color-primary-content-para)]">

                                @item.Email

                            </td>

                            <!-- Specialization -->
                            <td>

                                <span class="badge badge-outline px-3 py-3">

                                    @item.Specialization

                                </span>

                            </td>

                            <!-- Status -->
                            <td>

                                @if (item.Status == StatusEnum.Pending)
                                {
                                    <span class="badge badge-warning text-black px-3 py-3">

                                        Pending

                                    </span>
                                }
                                else if (item.Status == StatusEnum.Approved)
                                {
                                    <span class="badge badge-success text-black px-3 py-3">

                                        Approved

                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-error px-3 py-3">

                                        Rejected

                                    </span>
                                }

                            </td>

                            <!-- Request Date -->
                            <td class="text-sm text-[var(--color-primary-content-para)] whitespace-nowrap">

                                @item.RequestDate?.ToString("MMM dd, yyyy")

                            </td>

                            <!-- Actions -->
                            <td>

                                <div class="flex flex-wrap items-center justify-center gap-2">

                                    <!-- Details -->
                                    <a asp-action="ContributorDetails"
                                       asp-controller="Admin"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        Details

                                    </a>

                                    <!-- Certificate -->
                                    <a href="@item.CertificatePath"
                                       target="_blank"
                                       class="btn btn-sm btn-outline btn-primary">

                                        Certificate

                                    </a>

                                    <!-- Approve -->
                                    @if (item.Status == StatusEnum.Pending || item.Status == StatusEnum.Rejected)
                                    {
                                        <a asp-action="ApproveContributor"
                                           asp-controller="Admin"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-success text-black">

                                            Approve

                                        </a>
                                    }

                                    <!-- Reject -->
                                    @if (item.Status == StatusEnum.Pending || item.Status == StatusEnum.Approved)
                                    {
                                        <button class="btn btn-sm btn-error"
                                                onclick="document.getElementById('reject-modal-@item.Id').showModal()">

                                            Reject

                                        </button>
                                    }

                                </div>

                                <!-- Reject Modal -->
                                <dialog id="reject-modal-@item.Id"
                                        class="modal">

                                    <div class="modal-box bg-base-200 p-8 space-y-6">

                                        <!-- Header -->
                                        <div class="space-y-2">

                                            <h3 class="text-2xl font-bold">

                                                Reject Contributor

                                            </h3>

                                            <p class="text-[var(--color-primary-content-para)]">

                                                Provide a reason for rejecting this contributor request.

                                            </p>

                                        </div>

                                        <!-- Form -->
                                        <form asp-action="RejectContributor"
                                              asp-controller="Admin"
                                              method="post"
                                              class="space-y-6">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <textarea name="reason"
                                                      class="textarea textarea-bordered w-full h-40"
                                                      placeholder="Enter rejection reason..."
                                                      required></textarea>

                                            <div class="modal-action">

                                                <button type="submit"
                                                        class="btn btn-error">

                                                    Reject

                                                </button>

                                                <button type="button"
                                                        class="btn"
                                                        onclick="document.getElementById('reject-modal-@item.Id').close()">

                                                    Cancel

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </dialog>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>