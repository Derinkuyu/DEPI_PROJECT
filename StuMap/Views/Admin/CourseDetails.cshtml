@model CourseDetailsDto

@{
    ViewData["Title"] = "Course Details";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Back Button -->
    <div>

        <a asp-action="CourseRequests"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 whitespace-nowrap text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content mb-2">

            <i class="fa-solid fa-arrow-left"></i>

            Back to course requests

        </a>

    </div>

    <!-- Hero Section -->
    <div class="flex flex-col gap-10 rounded-[var(--radius-box)] bg-base-200 p-8 xl:flex-row xl:items-start xl:justify-between">

        <!-- Left -->
        <div class="flex-1 space-y-6">

            <!-- Title -->
            <div class="space-y-4">

                <h1 class="text-4xl font-bold tracking-tight text-base-content leading-tight">

                    @Model.Title

                </h1>

                <p class="text-lg leading-8 text-[var(--color-primary-content-para)] max-w-4xl">

                    @Model.Description

                </p>

            </div>

            <!-- Meta Badges -->
            <div class="flex flex-wrap gap-3">

                <!-- Contributor -->
                <div class="badge badge-primary px-5 py-4 gap-2">

                    <i class="fa-solid fa-circle-user"></i>

                    @Model.ContributorName

                </div>

                <!-- Roadmap -->
                @* @if (!string.IsNullOrEmpty(Model.RoadmapName))
                {
                    <div class="badge badge-outline badge-secondary px-5 py-4 gap-2">

                        <i class="fa-solid fa-diagram-project"></i>

                        @Model.RoadmapName

                    </div>
                } *@

                <!-- Materials -->
                <div class="badge badge-outline badge-success px-5 py-4 gap-2">

                    <i class="fa-solid fa-book-open"></i>

                    @Model.MaterialsCount Materials

                </div>

            </div>

            <!-- Status -->
            <div class="flex flex-wrap gap-3 pt-2">

                @if (Model.Status == StatusEnum.Pending)
                {
                    <div class="badge badge-warning badge-lg text-black px-4 py-4">

                        Pending

                    </div>
                }
                else if (Model.Status == StatusEnum.Approved)
                {
                    <div class="badge badge-success badge-lg text-black px-4 py-4">

                        Approved

                    </div>
                }
                else if (Model.Status == StatusEnum.UpdatedPending)
                {
                    <div class="badge badge-info badge-lg px-4 py-4">

                        Updated Request

                    </div>
                }
                else
                {
                    <div class="badge badge-error badge-lg px-4 py-4">

                        Rejected

                    </div>
                }

            </div>

        </div>

        <!-- Right Actions -->
        <div class="flex flex-row gap-4 w-50 xl:w-auto xl:min-w-[18rem]">

            @if (Model.Status == StatusEnum.Pending ||
           Model.Status == StatusEnum.UpdatedPending)
            {
                <!-- Approve -->
                <a asp-action="ApproveCourse"
                   asp-controller="Admin"
                   asp-route-id="@Model.Id"
                   class="btn btn-success text-black h-14">

                    <i class="fa-solid fa-check"></i>

                    Approve Course

                </a>

                <!-- Reject -->
                <button class="btn btn-error h-14"
                        onclick="document.getElementById('reject-modal').showModal()">

                    <i class="fa-solid fa-xmark"></i>

                    Reject Course

                </button>
            }

            <!-- Delete -->
            <a asp-action="DeleteCourse"
               asp-controller="Admin"
               asp-route-id="@Model.Id"
               class="btn btn-outline btn-error h-14">

                <i class="fa-solid fa-trash"></i>

                Delete Course

            </a>

        </div>

    </div>

    <!-- Course Information -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-8">

        <!-- Header -->
        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">

                Course Information

            </h2>

            <p class="text-[var(--color-primary-content-para)] leading-7">

                Review contributor information and course moderation metadata.

            </p>

        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Contributor -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Contributor

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.ContributorName

                </div>

            </div>

            <!-- Email -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Contributor Email

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.ContributorEmail

                </div>

            </div>

            <!-- Status -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Approval Status

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @if (Model.Status == StatusEnum.Pending)
                    {
                        <span class="badge badge-warning text-black">

                            Pending

                        </span>
                    }
                    else if (Model.Status == StatusEnum.Approved)
                    {
                        <span class="badge badge-success text-black">

                            Approved

                        </span>
                    }
                    else if (Model.Status == StatusEnum.UpdatedPending)
                    {
                        <span class="badge badge-info">

                            Updated Request

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error">

                            Rejected

                        </span>
                    }

                </div>

            </div>

            <!-- Materials -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Materials Count

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.MaterialsCount Materials

                </div>

            </div>

            <!-- Submitted -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Submitted At

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.SubmittedAt.ToString("MMMM dd, yyyy")

                </div>

            </div>

            <!-- Approved -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Approved At

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @(Model.ApprovedAt == null
                        ? "Not Approved Yet"
                        : Model.ApprovedAt.Value.ToString("MMMM dd, yyyy"))

                </div>

            </div>

        </div>

        <!-- Rejection Reason -->
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="pt-6 border-t border-base-300 space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-error">

                    Rejection Reason

                </p>

                <div class="rounded-[var(--radius-field)] bg-error/10 px-5 py-5 leading-7">

                    @Model.RejectionReason

                </div>

            </div>
        }

    </div>

    <!-- Materials Section -->
    <div class="space-y-6">

        <!-- Header -->
        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">

                All Materials

            </h2>

            <p class="text-[var(--color-primary-content-para)]">

                Explore all learning materials included in this course.

            </p>

        </div>

        <!-- Accordions -->
        <div id="all-accordions"
             class="space-y-5">

            @{
                int count = 0;
            }

            @foreach (var item in Model.Materials)
            {
                count++;

                <details class="collapse collapse-arrow bg-base-200"
                         open>

                    <input type="radio"
                           name="materials-accordion"
                           hidden />

                    <!-- Header -->
                    <summary class="collapse-title text-xl font-semibold flex items-center gap-3">

                        <span>

                            #@count @item.Title

                        </span>

                        <div class="badge badge-warning badge-soft">

                            @item.MaterialType

                        </div>

                    </summary>

                    <!-- Body -->
                    <div class="collapse-content px-6 pb-6">

                        <div class="space-y-6">

                            <!-- Description -->
                            <div class="space-y-3">

                                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                                    Description

                                </p>

                                <p class="text-lg leading-8 text-[var(--color-primary-content-para)]">

                                    @item.Description

                                </p>

                            </div>

                            <!-- URL -->
                            <div>

                                <a class="btn btn-outline btn-primary"
                                   href="@item.Url"
                                   target="_blank">

                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>

                                    Open Material

                                </a>

                            </div>

                        </div>

                    </div>

                </details>
            }

        </div>

    </div>

</section>

<!-- Reject Modal -->
<dialog id="reject-modal"
        class="modal">

    <div class="modal-box bg-base-200 max-w-2xl p-8 space-y-6">

        <!-- Header -->
        <div class="space-y-2">

            <h3 class="text-3xl font-bold">

                Reject Course Submission

            </h3>

            <p class="text-[var(--color-primary-content-para)]">

                Provide a clear explanation for rejecting this course request.

            </p>

        </div>

        <!-- Form -->
        <form asp-controller="Admin"
              asp-action="RejectCourse"
              method="post"
              class="space-y-6">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="space-y-3">

                <label class="text-sm font-semibold uppercase tracking-wide">

                    Rejection Reason

                </label>

                <textarea name="reason"
                          class="textarea textarea-bordered w-full h-40"
                          placeholder="Explain why the course was rejected..."
                          required></textarea>

            </div>

            <div class="modal-action">

                <button type="submit"
                        class="btn btn-error">

                    Reject Course

                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('reject-modal').close()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</dialog>