@model UserDetailsDto

@{
    ViewData["Title"] = "User Details";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Back Button -->
    <div>

        <a asp-action="Index"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 whitespace-nowrap text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content mb-2">

            <i class="fa-solid fa-arrow-left"></i>

            Back to users

        </a>

    </div>

    <!-- Hero Section -->
    <div class="flex flex-col gap-8 rounded-[var(--radius-box)] bg-base-200 p-8 xl:flex-row xl:items-start xl:justify-between">

        <!-- Left -->
        <div class="flex items-center gap-6">

            <!-- Avatar -->
            @* 
            <div class="avatar">

                <div class="w-24 rounded-full ring ring-primary ring-offset-2 ring-offset-base-200">

                    <img src="https://i.pravatar.cc/100?u=@Model.Email"
                         alt="@Model.FullName Avatar" />

                </div>

            </div> 
            *@

            <!-- User Info -->
            <div class="space-y-4">

                <!-- Name -->
                <div class="space-y-2">

                    <h1 class="text-4xl font-bold tracking-tight text-base-content">

                        @Model.FullName

                    </h1>

                    <div class="space-y-1">

                        <p class="text-sm text-[var(--color-primary-content-para)]">

                            @@@(Model.Email.Split('@')[0])

                        </p>

                        <p class="text-sm text-[var(--color-primary-content-para)]">

                            @Model.Email

                        </p>

                    </div>

                </div>

                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-3">

                    <!-- Role -->
                    <span class="badge badge-primary px-5 py-4">

                        @Model.Role

                    </span>

                    <!-- Status -->
                    @if (Model.IsBlocked)
                    {
                        <span class="badge badge-error px-5 py-4">

                            Blocked

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-success text-black px-5 py-4">

                            Active

                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- Actions -->
        <div class="flex flex-row gap-4 w-50 xl:w-auto xl:min-w-[16rem]">

            @if (Model.IsBlocked)
            {
                <a asp-action="Unblock"
                   asp-controller="Admin"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline btn-success h-14">

                    <i class="fa-solid fa-lock-open"></i>

                    Unblock User

                </a>
            }
            else
            {
                <a asp-action="Block"
                   asp-controller="Admin"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline btn-warning h-14">

                    <i class="fa-solid fa-ban"></i>

                    Block User

                </a>
            }

            <a asp-action="Delete"
               asp-controller="Admin"
               asp-route-id="@Model.Id"
               class="btn btn-outline btn-error h-14">

                <i class="fa-solid fa-trash"></i>

                Delete User

            </a>

        </div>

    </div>

    <!-- User Information -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-8">

        <!-- Header -->
        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">

                User Information

            </h2>

            <p class="text-[var(--color-primary-content-para)] leading-7">

                Complete account details and metadata.

            </p>

        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Email -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Email

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.Email

                </div>

            </div>

            <!-- Username -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Username

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @@@(Model.Email.Split('@')[0])

                </div>

            </div>

            <!-- Phone -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Phone Number

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @(string.IsNullOrEmpty(Model.PhoneNumber)
                        ? "Not Provided"
                        : Model.PhoneNumber)

                </div>

            </div>

            <!-- Role -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Role

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.Role

                </div>

            </div>

            <!-- Status -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Status

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @if (Model.IsBlocked)
                    {
                        <span class="badge badge-error">

                            Blocked

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-success text-black">

                            Active

                        </span>
                    }

                </div>

            </div>

            <!-- Joined Date -->
            <div class="space-y-3">

                <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    Joined Date

                </p>

                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @Model.CreatedAt.ToString("MMMM dd, yyyy")

                </div>

            </div>

        </div>

    </div>

</section>