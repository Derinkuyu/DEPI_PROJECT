@model IEnumerable<UserDto>

@{
    ViewData["Title"] = "User Management";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Header -->
    <div class="space-y-2">

        <h1 class="text-4xl font-bold tracking-tight text-base-content">
            User Management
        </h1>

        <p class="text-sm text-[var(--color-primary-content-para)] leading-7 max-w-3xl">
            Manage all users in one place. Control access, assign roles, and monitor activity across your platform.
        </p>

    </div>

    <!-- Toolbar -->
    <div class="flex flex-col gap-4 rounded-[var(--radius-box)] bg-base-200 p-6 lg:flex-row lg:items-center lg:justify-between">

        <!-- Filters -->
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-center w-full">

            <!-- Search -->
            <label class="input rounded-full bg-base-300 border-none w-full md:w-[320px] h-14 flex items-center">

                <svg class="h-[1em] opacity-50 mx-2"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24">

                    <g stroke-linejoin="round"
                       stroke-linecap="round"
                       stroke-width="2.5"
                       fill="none"
                       stroke="currentColor">

                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>

                    </g>

                </svg>

                <input type="search"
                       placeholder="Search users..."
                       class="bg-transparent border-none w-full outline-none" />

            </label>

            <!-- Role -->
            <select class="select select-bordered bg-base-100 border-base-300">
                <option disabled selected>Role</option>
                <option>Admin</option>
                <option>User</option>
                <option>Coordinator</option>
            </select>

            <!-- Status -->
            <select class="select select-bordered bg-base-100 border-base-300">
                <option disabled selected>Status</option>
                <option>Active</option>
                <option>Blocked</option>
            </select>

            <!-- Date -->
            <select class="select select-bordered bg-base-100 border-base-300">
                <option disabled selected>Date</option>
                <option>Newest</option>
                <option>Oldest</option>
            </select>

        </div>

    </div>

    <!-- Table -->
    <div class="overflow-x-auto rounded-[var(--radius-box)] bg-base-200">

        <table class="table">

            <!-- Head -->
            <thead>

                <tr class="text-xs uppercase tracking-wide text-[var(--color-primary-content-para)]">

                    <th>
                        <input type="checkbox" class="checkbox checkbox-sm" />
                    </th>

                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-center">Actions</th>

                </tr>

            </thead>

            <!-- Body -->
            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="hover:bg-base-300 transition-colors">

                        <!-- Checkbox -->
                        <td>
                            <input type="checkbox" class="checkbox checkbox-sm" />
                        </td>

                        <!-- Name -->
                        <td>
                            <div class="font-medium text-base-content">
                                @item.FullName
                            </div>
                        </td>

                        <!-- Email -->
                        <td class="text-sm text-[var(--color-primary-content-para)]">
                            @item.Email
                        </td>

                        <!-- Status -->
                        <td>
                            @if (item.IsBlocked)
                            {
                                <span class="badge badge-error px-4 py-3">Blocked</span>
                            }
                            else
                            {
                                <span class="badge badge-success text-black px-4 py-3">Active</span>
                            }
                        </td>

                        <!-- Created -->
                        <td class="text-sm text-[var(--color-primary-content-para)]">
                            @item.CreatedAt.ToString("MMM dd, yyyy")
                        </td>

                        <!-- Actions -->
                        <td>
                            <div class="flex items-center justify-center gap-2">

                                <a asp-action="Details"
                                   asp-controller="Admin"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    Details
                                </a>

                                @if (item.IsBlocked)
                                {
                                    <a asp-action="Unblock"
                                       asp-controller="Admin"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-success btn-outline">
                                        Unblock
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Block"
                                       asp-controller="Admin"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning btn-outline">
                                        Block
                                    </a>
                                }

                                <a asp-action="Delete"
                                   asp-controller="Admin"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-error btn-outline">
                                    Delete
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Pagination -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

        <!-- Left -->
        <div class="flex items-center gap-3 text-sm">

            <span class="text-[var(--color-primary-content-para)]">
                Rows per page
            </span>

            <select class="select select-bordered select-sm bg-base-100 border-base-300">
                <option selected>10</option>
            </select>

            <span class="text-[var(--color-primary-content-para)]">
                of @Model.Count() rows
            </span>

        </div>

        <!-- Right -->
        <div class="join">

            <button class="join-item btn btn-ghost">«</button>
            <button class="join-item btn btn-ghost">‹</button>
            <button class="join-item btn btn-primary">1</button>
            <button class="join-item btn btn-ghost">2</button>
            <button class="join-item btn btn-ghost">3</button>
            <button class="join-item btn btn-ghost">›</button>
            <button class="join-item btn btn-ghost">»</button>

        </div>

    </div>

</section>