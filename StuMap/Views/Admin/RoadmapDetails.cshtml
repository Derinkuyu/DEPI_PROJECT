@model RoadmapDetailsDto

@{
    ViewData["Title"] = "Roadmap Details";
}

<section class="max-w-7xl mx-auto px-8 py-10 space-y-10">

    <!-- Back Button -->
    <div>

        <a asp-action="RoadmapRequests"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content">

            <i class="fa-solid fa-arrow-left"></i>
            Back to roadmap requests

        </a>

    </div>

    <!-- Hero Section -->
    <div class="flex flex-col lg:flex-row gap-8 rounded-[var(--radius-box)] bg-base-200 p-8 lg:items-start lg:justify-between">

        <!-- Left -->
        <div class="space-y-4">

            <div class="space-y-2">

                <h1 class="text-4xl font-bold tracking-tight text-base-content">

                    <i class="fa-solid fa-diagram-project text-primary mr-2"></i>

                    @Model.Name

                </h1>

                <p class="text-sm text-[var(--color-primary-content-para)]">

                    Submitted by
                    <span class="font-medium text-base-content">
                        @Model.ContributorName
                    </span>

                </p>

            </div>

            <!-- Badges -->
            <div class="flex flex-wrap gap-3">

                <span class="badge badge-primary px-5 py-4">
                    @Model.Specialization
                </span>

                @if (Model.Status == RoadmapStatus.Pending)
                {
                    <span class="badge badge-warning text-black px-5 py-4">Pending</span>
                }
                else if (Model.Status == RoadmapStatus.Approved)
                {
                    <span class="badge badge-success text-black px-5 py-4">Approved</span>
                }
                else if (Model.Status == RoadmapStatus.UpdatedPending)
                {
                    <span class="badge badge-info px-5 py-4">Updated</span>
                }
                else
                {
                    <span class="badge badge-error px-5 py-4">Rejected</span>
                }

            </div>

        </div>

        <!-- Actions -->
        <div class="flex flex-col gap-3 w-full lg:w-auto lg:min-w-[16rem]">

            @if (Model.Status == RoadmapStatus.Pending ||
                 Model.Status == RoadmapStatus.UpdatedPending)
            {
                <a asp-action="ApproveRoadmap"
                   asp-controller="Admin"
                   asp-route-id="@Model.Id"
                   class="btn btn-success text-black">

                    <i class="fa-solid fa-check"></i>
                    Approve

                </a>

                <button class="btn btn-error"
                        onclick="document.getElementById('reject-modal').showModal()">

                    <i class="fa-solid fa-xmark"></i>
                    Reject

                </button>
            }

            <a asp-action="DeleteRoadmap"
               asp-controller="Admin"
               asp-route-id="@Model.Id"
               class="btn btn-outline btn-error">

                <i class="fa-solid fa-trash"></i>
                Delete

            </a>

        </div>

    </div>

    <!-- Information -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-8">

        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">
                Roadmap Information
            </h2>

            <p class="text-sm text-[var(--color-primary-content-para)] leading-7">
                Complete roadmap submission details and approval metadata.
            </p>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Name
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @Model.Name
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Specialization
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @Model.Specialization
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Contributor
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @Model.ContributorName
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Email
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @Model.ContributorEmail
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Status
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">

                    @if (Model.Status == RoadmapStatus.Pending)
                    {
                        <span class="badge badge-warning text-black">Pending</span>
                    }
                    else if (Model.Status == RoadmapStatus.Approved)
                    {
                        <span class="badge badge-success text-black">Approved</span>
                    }
                    else if (Model.Status == RoadmapStatus.UpdatedPending)
                    {
                        <span class="badge badge-info">Updated</span>
                    }
                    else
                    {
                        <span class="badge badge-error">Rejected</span>
                    }

                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Submitted At
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @Model.SubmittedAt.ToString("MMMM dd, yyyy")
                </div>
            </div>

            <div class="space-y-3 md:col-span-2">
                <p class="text-sm uppercase tracking-wide text-[var(--color-primary-content-para)]">
                    Approved At
                </p>
                <div class="rounded-[var(--radius-field)] bg-base-100 px-4 py-4">
                    @(Model.ApprovedAt == null
                        ? "Not Approved Yet"
                        : Model.ApprovedAt.Value.ToString("MMMM dd, yyyy"))
                </div>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="space-y-3">

                <p class="text-sm uppercase tracking-wide text-error">
                    Rejection Reason
                </p>

                <div class="rounded-[var(--radius-field)] bg-error/10 border border-error px-4 py-4">
                    @Model.RejectionReason
                </div>

            </div>
        }

    </div>

    <!-- Description -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-6">

        <div class="space-y-2">

            <h2 class="text-3xl font-semibold text-base-content">
                Description
            </h2>

            <p class="text-sm text-[var(--color-primary-content-para)]">
                Contributor roadmap overview and learning objectives.
            </p>

        </div>

        <div class="text-base-content leading-7">
            @Model.Description
        </div>

    </div>

    <!-- Courses -->
    <div class="rounded-[var(--radius-box)] bg-base-200 p-8 space-y-6">

        <div class="flex items-center justify-between flex-wrap gap-4">

            <div class="space-y-2">

                <h2 class="text-3xl font-semibold text-base-content">
                    Courses
                </h2>

                <p class="text-sm text-[var(--color-primary-content-para)]">
                    Courses included inside this roadmap.
                </p>

            </div>

            <div class="badge badge-primary badge-lg">
                @Model.Courses.Count Courses
            </div>

        </div>

        <div class="overflow-x-auto rounded-[var(--radius-box)]">

            <table class="table">

                <thead>
                    <tr class="text-xs uppercase tracking-wide text-[var(--color-primary-content-para)]">
                        <th>#</th>
                        <th>Course</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int i = 1;
                    }

                    @foreach (var course in Model.Courses)
                    {
                        <tr class="hover:bg-base-300 transition">

                            <td>@i</td>

                            <td class="font-medium text-base-content">
                                @course.Title
                            </td>

                            <td class="text-center">

                                <a asp-action="CourseDetails"
                                   asp-controller="Admin"
                                   asp-route-id="@course.Id"
                                   class="btn btn-sm btn-primary">

                                    View

                                </a>

                            </td>

                        </tr>

                        i++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>

<!-- Reject Modal -->
<dialog id="reject-modal" class="modal">

    <div class="modal-box bg-base-100">

        <h3 class="text-xl font-semibold mb-4">
            Reject Roadmap
        </h3>

        <form asp-action="RejectRoadmap"
              asp-controller="Admin"
              method="post"
              class="space-y-4">

            <input type="hidden" name="id" value="@Model.Id" />

            <textarea name="reason"
                      class="textarea textarea-bordered w-full h-32"
                      placeholder="Enter reason..."
                      required></textarea>

            <div class="modal-action">

                <button type="submit" class="btn btn-error">
                    Reject
                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('reject-modal').close()">
                    Cancel
                </button>

            </div>

        </form>

    </div>

</dialog>