@model Contact

@{
    ViewData["Title"] = "Ticket Details";
}

<section class="px-12 my-8 p-5">

    <!-- Back Button -->
    <div class="mb-6">

        <a asp-action="TicketRequests"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 whitespace-nowrap text-sm text-[var(--color-primary-content-para)] transition hover:text-base-content">

            <i class="fa-solid fa-arrow-left"></i>

            Back to ticket requests

        </a>

    </div>

    <!-- Hero Section -->
    <div class="grid grid-cols-4 gap-6">

        <!-- Left -->
        <div class="col-span-3 space-y-4">

            <!-- Subject -->
            <p class="text-4xl font-semibold">

                <i class="fa-solid fa-angle-right"></i>

                @Model.Subject

            </p>

            <!-- Message Preview -->
            <p class="text-xl text-primary-content leading-9">

                @Model.Body

            </p>

            <!-- User -->
            <div class="flex flex-wrap gap-3">

                <div class="text-xl badge badge-dash badge-primary p-5">

                    <i class="fa-solid fa-circle-user"></i>

                    @Model.User?.UserName

                </div>

                <!-- Read Status -->
                @if (Model.IsRead)
                {
                    <div class="text-xl badge badge-outline badge-info p-5">

                        <i class="fa-solid fa-envelope-open"></i>

                        Read

                    </div>
                }
                else
                {
                    <div class="text-xl badge badge-outline badge-warning p-5">

                        <i class="fa-solid fa-envelope"></i>

                        Unread

                    </div>
                }

            </div>

            <!-- Status -->
            <div class="flex flex-wrap gap-3">

                @if (Model.Status == StuMap.Models.Enums.TicketStatus.Pending)
                {
                    <div class="badge badge-warning text-black badge-lg">

                        Pending

                    </div>
                }
                else if (Model.Status == StuMap.Models.Enums.TicketStatus.Considered)
                {
                    <div class="badge badge-success text-black badge-lg">

                        Considered

                    </div>
                }
                else
                {
                    <div class="badge badge-error badge-lg">

                        Denied

                    </div>
                }

            </div>

        </div>

        <!-- Right Actions -->
        <div class="flex flex-col gap-4 items-stretch">

            @if (Model.Status == StuMap.Models.Enums.TicketStatus.Pending)
            {
                <!-- Accept -->
                <button class="btn btn-success text-black rounded-full h-14"
                        onclick="document.getElementById('accept-modal').showModal()">

                    <i class="fa-solid fa-check"></i>

                    Accept Ticket

                </button>

                <!-- Reject -->
                <button class="btn btn-error rounded-full h-14"
                        onclick="document.getElementById('reject-modal').showModal()">

                    <i class="fa-solid fa-xmark"></i>

                    Reject Ticket

                </button>
            }

            <!-- Delete -->
            <a asp-action="DeleteTicket"
               asp-controller="Admin"
               asp-route-id="@Model.Id"
               class="btn btn-outline btn-error rounded-full h-14">

                <i class="fa-solid fa-trash"></i>

                Delete Ticket

            </a>

        </div>

    </div>

    <!-- Divider -->
    <div class="divider my-10"></div>

    <!-- Information Card -->
    <div class="rounded-2xl border border-base-300 bg-base-100 p-8 mb-10">

        <!-- Header -->
        <div class="mb-8">

            <h2 class="text-3xl font-semibold">

                Ticket Information

            </h2>

            <p class="text-primary-content mt-2">

                Review ticket metadata, user information,
                and support request details.

            </p>

        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- User -->
            <div class="space-y-2">

                <p class="text-sm text-primary-content font-medium">

                    Submitted By

                </p>

                <div class="rounded-xl bg-base-200 border border-base-300 p-4">

                    @Model.User?.UserName

                </div>

            </div>

            <!-- Email -->
            <div class="space-y-2">

                <p class="text-sm text-primary-content font-medium">

                    User Email

                </p>

                <div class="rounded-xl bg-base-200 border border-base-300 p-4">

                    @Model.User?.Email

                </div>

            </div>

            <!-- Status -->
            <div class="space-y-2">

                <p class="text-sm text-primary-content font-medium">

                    Ticket Status

                </p>

                <div class="rounded-xl bg-base-200 border border-base-300 p-4">

                    @if (Model.Status == StuMap.Models.Enums.TicketStatus.Pending)
                    {
                        <span class="badge badge-warning text-black">

                            Pending

                        </span>
                    }
                    else if (Model.Status == StuMap.Models.Enums.TicketStatus.Considered)
                    {
                        <span class="badge badge-success text-black">

                            Considered

                        </span>
                    }
                    else
                    {
                        <span class="badge badge-error">

                            Denied

                        </span>
                    }

                </div>

            </div>

            <!-- Sent Date -->
            <div class="space-y-2">

                <p class="text-sm text-primary-content font-medium">

                    Submitted At

                </p>

                <div class="rounded-xl bg-base-200 border border-base-300 p-4">

                    @Model.DateSent.ToString("MMMM dd, yyyy")

                </div>

            </div>

        </div>

    </div>

    <!-- Full Message -->
    <div class="rounded-2xl border border-base-300 bg-base-100 p-8 mb-10">

        <div class="mb-6">

            <h2 class="text-3xl font-semibold">

                User Message

            </h2>

            <p class="text-primary-content mt-2">

                Complete support request submitted by the user.

            </p>

        </div>

        <div class="rounded-2xl bg-base-200 border border-base-300 p-6">

            <p class="text-lg leading-9 whitespace-pre-line">

                @Model.Body

            </p>

        </div>

    </div>

    <!-- Resolution Section -->
    @if (Model.Status == StuMap.Models.Enums.TicketStatus.Considered &&
    !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="rounded-2xl border border-success/30 bg-success/10 p-8 mb-10">

            <div class="mb-6">

                <h2 class="text-3xl font-semibold text-success">

                    Admin Reply

                </h2>

                <p class="text-success mt-2">

                    Response sent to the user regarding this ticket.

                </p>

            </div>

            <div class="rounded-2xl bg-base-100 border border-success/20 p-6">

                <p class="text-lg leading-9 whitespace-pre-line">

                    @Model.AdminReply

                </p>

            </div>

        </div>
    }

    <!-- Rejection Section -->
    @if (Model.Status == StuMap.Models.Enums.TicketStatus.Denied &&
    !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="rounded-2xl border border-error/30 bg-error/10 p-8">

            <div class="mb-6">

                <h2 class="text-3xl font-semibold text-error">

                    Rejection Reason

                </h2>

                <p class="text-error mt-2">

                    Reason provided by the administrator.

                </p>

            </div>

            <div class="rounded-2xl bg-base-100 border border-error/20 p-6">

                <p class="text-lg leading-9 whitespace-pre-line">

                    @Model.RejectionReason

                </p>

            </div>

        </div>
    }

</section>

<!-- Accept Modal -->
<dialog id="accept-modal"
        class="modal">

    <div class="modal-box w-11/12 max-w-2xl">

        <h3 class="font-bold text-2xl mb-6">

            Accept Ticket

        </h3>

        <form asp-controller="Admin"
              asp-action="AcceptTicket"
              method="post"
              class="space-y-6">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="space-y-2">

                <label class="font-medium">

                    Reply Message

                </label>

                <textarea name="reply"
                          class="textarea textarea-bordered w-full h-40"
                          placeholder="Write your response to the user..."
                          required></textarea>

            </div>

            <div class="modal-action">

                <button type="submit"
                        class="btn btn-success text-black">

                    Accept Ticket

                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('accept-modal').close()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</dialog>

<!-- Reject Modal -->
<dialog id="reject-modal"
        class="modal">

    <div class="modal-box w-11/12 max-w-2xl">

        <h3 class="font-bold text-2xl mb-6">

            Reject Ticket

        </h3>

        <form asp-controller="Admin"
              asp-action="RejectTicket"
              method="post"
              class="space-y-6">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="space-y-2">

                <label class="font-medium">

                    Rejection Reason

                </label>

                <textarea name="reason"
                          class="textarea textarea-bordered w-full h-40"
                          placeholder="Explain why the ticket was rejected..."
                          required></textarea>

            </div>

            <div class="modal-action">

                <button type="submit"
                        class="btn btn-error">

                    Reject Ticket

                </button>

                <button type="button"
                        class="btn"
                        onclick="document.getElementById('reject-modal').close()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</dialog>