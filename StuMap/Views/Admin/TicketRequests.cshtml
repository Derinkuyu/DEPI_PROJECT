@using StuMap.DAL.Models
@using StuMap.DAL.Models.Enums
@model List<Contact>

@{
    ViewData["Title"] = "Ticket Requests";
}

<section class="mx-6 my-8 p-5">

    <!-- Header -->
    <div class="flex flex-col justify-center items-center text-center">

        <p class="text-4xl font-semibold">
            Support Ticket Requests
        </p>

        <p class="text-xl text-primary-content w-200 my-2">
            Review user submitted support tickets, investigate reported issues,
            and manage platform communication requests.
        </p>

    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center justify-between gap-4 my-10">

        <!-- Search -->
        <label class="input input-bordered rounded-full w-96">

            <i class="fa-solid fa-magnifying-glass opacity-70"></i>

            <input type="text"
                   class="grow"
                   placeholder="Search Tickets..." />

        </label>

        <!-- Right Controls -->
        <div class="flex flex-wrap gap-3">

            <!-- Status -->
            <select class="select select-bordered">

                <option disabled selected>
                    Status
                </option>

                <option>
                    Pending
                </option>

                <option>
                    Considered
                </option>

                <option>
                    Denied
                </option>

            </select>

            <!-- Read -->
            <select class="select select-bordered">

                <option disabled selected>
                    Read Status
                </option>

                <option>
                    Read
                </option>

                <option>
                    Unread
                </option>

            </select>

        </div>

    </div>

    <!-- Tickets Grid -->
    <div class="grid grid-cols-3 gap-x-8 gap-y-10 my-12">

        @foreach (var ticket in Model)
        {
            <div class="hover-3d cursor-pointer mx-3">

                <!-- Card -->
                <div class="card h-[30rem] bg-base-300 border border-base-300 rounded-2xl">

                    <div class="card-body flex flex-col justify-between gap-4">

                        <!-- Top -->
                        <div class="space-y-4">

                            <!-- Subject -->
                            <div class="space-y-3">

                                <div class="flex items-start justify-between gap-3">

                                    <h2 class="card-title text-2xl leading-snug">

                                        @ticket.Subject

                                    </h2>

                                    <!-- Status -->
                                    @if (ticket.Status == TicketStatusEnum.Pending)
                                    {
                                        <div class="badge badge-warning text-black whitespace-nowrap">

                                            Pending

                                        </div>
                                    }
                                    else if (ticket.Status == TicketStatusEnum.Considered)
                                    {
                                        <div class="badge badge-success text-black whitespace-nowrap">

                                            Considered

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge badge-error whitespace-nowrap">

                                            Denied

                                        </div>
                                    }

                                </div>

                                <!-- User -->
                                <div class="badge badge-secondary">

                                    By @ticket.User?.UserName

                                </div>

                            </div>

                            <!-- Message Preview -->
                            <div>

                                <p class="text-base/7 text-primary-content h-28 overflow-hidden">

                                    @ticket.Body

                                </p>

                                <span class="text-primary-content">
                                    ...
                                </span>

                            </div>

                            <!-- Read Status -->
                            <div class="flex items-center gap-2">

                                @if (ticket.IsRead)
                                {
                                    <div class="badge badge-info gap-2">

                                        <i class="fa-solid fa-envelope-open"></i>

                                        Read

                                    </div>
                                }
                                else
                                {
                                    <div class="badge badge-outline badge-warning gap-2">

                                        <i class="fa-solid fa-envelope"></i>

                                        Unread

                                    </div>
                                }

                            </div>

                            <!-- Date -->
                            <div class="flex items-center gap-2 text-primary-content">

                                <i class="fa-solid fa-calendar"></i>

                                <span>

                                    @ticket.DateSent.ToString("MMM dd, yyyy")

                                </span>

                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col gap-3">

                            <!-- Details -->
                            <a asp-controller="Admin"
                               asp-action="TicketDetails"
                               asp-route-id="@ticket.Id"
                               class="btn btn-primary btn-outline rounded-full">

                                More Details

                                <i class="fa-solid fa-arrow-right-long"></i>

                            </a>

                            <!-- Approval Actions -->
                            @if (ticket.Status == TicketStatusEnum.Pending)
                            {
                                <div class="flex gap-2">

                                    <!-- Accept -->
                                    <button class="btn btn-success text-black flex-1"
                                            onclick="document.getElementById('accept-modal-@ticket.Id').showModal()">

                                        <i class="fa-solid fa-check"></i>

                                        Accept

                                    </button>

                                    <!-- Reject -->
                                    <button class="btn btn-error flex-1"
                                            onclick="document.getElementById('reject-modal-@ticket.Id').showModal()">

                                        <i class="fa-solid fa-xmark"></i>

                                        Reject

                                    </button>

                                </div>
                            }

                            <!-- Delete -->
                            <a asp-controller="Admin"
                               asp-action="DeleteTicket"
                               asp-route-id="@ticket.Id"
                               class="btn btn-outline btn-error rounded-full">

                                <i class="fa-solid fa-trash"></i>

                                Delete Ticket

                            </a>

                        </div>

                    </div>

                </div>

                @* <!-- 3D Effect Divs -->
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div> *@

            </div>

            <!-- Accept Modal -->
            <dialog id="accept-modal-@ticket.Id"
                    class="modal">

                <div class="modal-box w-11/12 max-w-2xl">

                    <h3 class="font-bold text-2xl mb-6">

                        Accept Ticket

                    </h3>

                    <form asp-controller="Admin"
                          asp-action="AcceptTicket"
                          method="post"
                          class="space-y-6">

                        <input type="hidden"
                               name="id"
                               value="@ticket.Id" />

                        <div class="space-y-2">

                            <label class="font-medium">

                                Reply Message

                            </label>

                            <textarea name="reply"
                                      class="textarea textarea-bordered w-full h-40"
                                      placeholder="Write your response to the user..."
                                      required></textarea>

                        </div>

                        <div class="modal-action">

                            <button type="submit"
                                    class="btn btn-success text-black">

                                Accept Ticket

                            </button>

                            <button type="button"
                                    class="btn"
                                    onclick="document.getElementById('accept-modal-@ticket.Id').close()">

                                Cancel

                            </button>

                        </div>

                    </form>

                </div>

            </dialog>

            <!-- Reject Modal -->
            <dialog id="reject-modal-@ticket.Id"
                    class="modal">

                <div class="modal-box w-11/12 max-w-2xl">

                    <h3 class="font-bold text-2xl mb-6">

                        Reject Ticket

                    </h3>

                    <form asp-controller="Admin"
                          asp-action="RejectTicket"
                          method="post"
                          class="space-y-6">

                        <input type="hidden"
                               name="id"
                               value="@ticket.Id" />

                        <div class="space-y-2">

                            <label class="font-medium">

                                Rejection Reason

                            </label>

                            <textarea name="reason"
                                      class="textarea textarea-bordered w-full h-40"
                                      placeholder="Explain why the ticket was rejected..."
                                      required></textarea>

                        </div>

                        <div class="modal-action">

                            <button type="submit"
                                    class="btn btn-error">

                                Reject Ticket

                            </button>

                            <button type="button"
                                    class="btn"
                                    onclick="document.getElementById('reject-modal-@ticket.Id').close()">

                                Cancel

                            </button>

                        </div>

                    </form>

                </div>

            </dialog>
        }

    </div>

</section>