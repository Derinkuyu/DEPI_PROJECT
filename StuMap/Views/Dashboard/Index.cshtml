@model List<Course>
@{
    ViewData["Title"] = "Admin Dashboard – StuMap";
    // Layout = null;
}

    <style>

        .glass-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--stumap-border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 16px;
        transition: all 0.25s ease;
        }

        .glass-card:hover {
        background: rgba(255, 255, 255, 0.065);
        border-color: var(--stumap-accent-border);
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--stumap-accent-border);
        }

        .stat-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--stumap-border);
        border-radius: 16px;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
        }

        .stat-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top left, var(--card-glow, rgba(110,231,183,0.06)) 0%, transparent 65%);
        pointer-events: none;
        }

        .stat-card:hover {
        border-color: var(--stumap-accent-border);
        transform: translateY(-3px);
        box-shadow: 0 16px 48px rgba(0,0,0,0.4);
        }

        .icon-orb {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        }

        .action-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--stumap-border);
        border-radius: 14px;
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        color: inherit;
        }

        .action-card:hover {
        background: var(--stumap-accent-soft);
        border-color: var(--stumap-accent-border);
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
        }

        .action-card .action-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: var(--stumap-accent-soft);
        border: 1px solid var(--stumap-accent-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: var(--stumap-accent);
        }

        .activity-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid var(--stumap-border);
        transition: background 0.15s;
        }

        .activity-row:last-child {
        border-bottom: none;
        }

        .activity-row:hover {
        background: rgba(255,255,255,0.02);
        border-radius: 8px;
        padding-left: 8px;
        }

        .activity-dot {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
        margin-top: 2px;
        }

        .btn-stumap {
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #0D2B1F;
        border: none;
        font-weight: 600;

        transition: all 0.2s ease;
        }

        .btn-stumap:hover {
        background: linear-gradient(135deg, var(--color-secondary), #059669);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(52,211,153,0.35);
        }

        .breadcrumb-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--stumap-accent-soft);
        border: 1px solid var(--stumap-accent-border);
        color: var(--stumap-accent);
        padding: 4px 14px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        }

        .section-title {
      
        font-size: 1.05rem;
        font-weight: 700;
        color: #F0F6F2;
        letter-spacing: -0.01em;
        }

        ::-webkit-scrollbar {
        width: 6px;
        }

        ::-webkit-scrollbar-track {
        background: transparent;
        }

        ::-webkit-scrollbar-thumb {
        background: var(--color-primary);
        border-radius: 4px;
        }

        .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 0 3px var(--color-primary);
        animation: livePulse 2s ease infinite;
        }

        @@keyframes livePulse {
        0%, 100% {
        box-shadow: 0 0 0 3px var(--color-primary);
        }

        50% {
        box-shadow: 0 0 0 6px rgba(110,231,183,0.06);
        }
        }

        /* ── Specializations Tags ── */
        .spec-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 500;
        background: rgba(183, 132, 255, 0.11);
        border: 1px solid var(--color-primary);
        color: var(--color-primary);
        transition: all 0.2s ease;
        cursor: default;
        }

        .spec-tag:hover {
        background: rgba(110, 231, 183, 0.15);
        border-color: rgba(110, 231, 183, 0.35);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(110, 231, 183, 0.12);
        }

        .spec-tag:nth-child(3n+1) {
        /* background: rgba(110, 231, 183, 0.07); */
        border-color: rgba(183, 132, 255, 0.486);
        color: var(--color-primary);
        }

        .spec-tag:nth-child(3n+2) {
        background: rgba(103, 232, 249, 0.07);
        border-color: rgba(103, 232, 249, 0.18);
        color: #67E8F9;
        }

        .spec-tag:nth-child(3n) {
        background: rgba(167, 139, 250, 0.07);
        border-color: rgba(167, 139, 250, 0.18);
        color: #A78BFA;
        }

        .spec-tag:nth-child(3n+1):hover {
        box-shadow: 0 4px 16px rgba(110, 231, 183, 0.12);
        }

        .spec-tag:nth-child(3n+2):hover {
        box-shadow: 0 4px 16px rgba(103, 232, 249, 0.12);
        }

        .spec-tag:nth-child(3n):hover {
        box-shadow: 0 4px 16px rgba(167, 139, 250, 0.12);
        }

        .spec-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: 0.65rem;
        font-weight: 700;
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
        }

        @@media (max-width: 640px) {
        .font-display.text-3xl {
        font-size: 1.5rem;
        }
        }
    </style>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="max-w-screen-2xl mx-10 px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- ── 1. HEADER ── -->
        <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-2">
                <div class="breadcrumb-pill">
                    <i class="fa-solid fa-gauge-high text-xs"></i>
                    Dashboard
                </div>  
                <h1 class="font-display text-3xl sm:text-4xl font-800 leading-tight mt-1"
                    style=" font-weight:800; color:#F0F6F2; letter-spacing:-0.02em;">
                    Welcome Back, Admin 👋
                </h1>
                <p class="text-sm" style="color:rgba(255,255,255,0.5);">
                    Here's what's happening in <span style="color:var(--color-primary); font-weight:500;">StuMap</span> today.
                </p>
            </div>

            <div class="flex-shrink-0 glass-card px-5 py-3 flex items-center gap-3">
                <i class="fa-regular fa-calendar-check" style="color:var(--color-primary);"></i>
                <div>
                    <p class="text-xs" style="color:rgba(255,255,255,0.4);">Today</p>
                    <p class="text-sm font-medium" style="color:#E2E8F0;">@DateTime.Now.ToString("dddd, MMM dd yyyy")</p>
                </div>
            </div>
        </section>


        <!-- ── 2. STAT CARDS ── -->
        <section>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

                <!-- Card 1 · Total Users -->
                <div class="stat-card p-5" style="--card-glow: rgba(110,231,183,0.08);">
                    <div class="flex items-start justify-between mb-4">
                        <div class="icon-orb"
                             style="  border:1px solid var(--color-primary); color:var(--color-primary);">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <span class="badge badge-sm"
                              style="  color:var(--color-primary); border:1px solid var(--color-primary);">
                            All Time
                        </span>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.4);">Total Users</p>
                    <p class="font-display text-4xl font-800 mb-3"
                       style=" font-weight:800; color:#F0F6F2; letter-spacing:-0.03em;">
                        @ViewBag.UsersCount
                    </p>
                    <div class="flex gap-3 text-xs" style="color:rgba(255,255,255,0.5);">
                        <span class="flex items-center gap-1">
                            <i class="fa-solid fa-graduation-cap" style="color:#67E8F9;"></i>
                            @ViewBag.StudentCount Students
                        </span>
                        <span class="flex items-center gap-1">
                            <i class="fa-solid fa-pen-nib" style="color:#C084FC;"></i>
                            @ViewBag.ContributorCount Contributor
                        </span>
                    </div>
                </div>

                <!-- Card 2 · Pending Contributor Requests -->
                <div class="stat-card p-5" style="--card-glow: rgba(252,211,77,0.07);">
                    <div class="flex items-start justify-between mb-4">
                        <div class="icon-orb"
                             style="background:rgba(252,211,77,0.1); border:1px solid rgba(252,211,77,0.2); color:#FCD34D;">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                        <span class="badge badge-warning badge-sm badge-outline">Pending</span>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.4);">Contributor Requests</p>
                    <p class="font-display text-4xl font-800 mb-3"
                       style=" font-weight:800; color:#F0F6F2; letter-spacing:-0.03em;">
                        @ViewBag.ContributorRequests
                    </p>
                    <a asp-controller="Admin" asp-action="ContributorRequests"
                       class="btn btn-xs w-full rounded-xl font-semibold"
                       style="background:rgba(252,211,77,0.1); color:#FCD34D; border:1px solid rgba(252,211,77,0.2);">
                        <i class="fa-solid fa-arrow-right-long text-xs"></i>
                        Review Requests
                    </a>
                </div>

                <!-- Card 3 · Pending Roadmaps -->
                <div class="stat-card p-5" style="--card-glow: rgba(167,139,250,0.07);">
                    <div class="flex items-start justify-between mb-4">
                        <div class="icon-orb"
                             style="background:rgba(167,139,250,0.1); border:1px solid rgba(167,139,250,0.2); color:#A78BFA;">
                            <i class="fa-solid fa-map-location-dot"></i>
                        </div>
                        <span class="badge badge-sm"
                              style="background:rgba(167,139,250,0.1); color:#A78BFA; border:1px solid rgba(167,139,250,0.2);">
                            Awaiting
                        </span>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.4);">Pending Roadmaps</p>
                    <p class="font-display text-4xl font-800 mb-3"
                       style=" font-weight:800; color:#F0F6F2; letter-spacing:-0.03em;">
                        @ViewBag.RoadMaps.Count
                    </p>
                    <a asp-controller="Admin" asp-action="Roadmaprequests"
                       class="btn btn-xs w-full rounded-xl font-semibold"
                       style="background:rgba(167,139,250,0.1); color:#A78BFA; border:1px solid rgba(167,139,250,0.2);">
                        <i class="fa-solid fa-arrow-right-long text-xs"></i>
                        Manage Roadmaps
                    </a>
                </div>

                <!-- Card 4 · Total Courses -->
                <div class="stat-card p-5" style="--card-glow: rgba(103,232,249,0.07);">
                    <div class="flex items-start justify-between mb-4">
                        <div class="icon-orb"
                             style="background:rgba(103,232,249,0.1); border:1px solid rgba(103,232,249,0.2); color:#67E8F9;">
                            <i class="fa-solid fa-book-open-reader"></i>
                        </div>
                        <span class="badge badge-info badge-sm badge-outline">Total</span>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.4);">Pending Courses</p>
                    <p class="font-display text-4xl font-800 mb-3"
                       style="font-weight:800; color:#F0F6F2; letter-spacing:-0.03em;">
                        @ViewBag.Course.Count
                    </p>
                    <a asp-controller="Admin" asp-action="CourseRequests"
                       class="btn btn-xs w-full rounded-xl font-semibold"
                       style="background:rgba(103,232,249,0.1); color:#67E8F9; border:1px solid rgba(103,232,249,0.2);">
                        <i class="fa-solid fa-arrow-right-long text-xs"></i>
                        Manage Courses
                    </a>
                </div>

            </div>
        </section>


        <!-- ── 3. CHARTS ── -->
        <section>
            <div class="flex items-center justify-between mb-4">
                <h2 class="section-title flex items-center gap-2">
                    <i class="fa-solid fa-chart-line" style="color:var(--color-primary); font-size:0.95rem;"></i>
                    Analytics Overview
                </h2>
                <span class="text-xs" style="color:rgba(255,255,255,0.4);">Updated live</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <!-- ① User Distribution Donut (unchanged) -->
                <div class="glass-card p-6" style="border-radius:24px;">
                    <div class="mb-5">
                        <h3 class="font-display text-base font-bold"
                            style=" font-weight:700; color:#F0F6F2;">
                            User Distribution
                        </h3>
                        <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.5);">
                            Students vs Contributors vs Admins
                        </p>
                    </div>
                    <div style="height:220px;">
                        <div id="usersChart" style="width:100%; height:100%;"></div>
                    </div>
                    <div class="flex justify-center gap-6 mt-5 text-xs" style="color:rgba(255,255,255,0.6);">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full" style="background:var(--color-primary);"></span>Students
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full" style="background:#67E8F9;"></span>Contributors
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full" style="background:#C084FC;"></span>Admins
                        </div>
                    </div>
                </div>

                <!-- ② NEW · Roadmap Status (Approved vs Pending) -->
                <div class="glass-card p-6" style="border-radius:24px;">
                    <div class="mb-5">
                        <h3 class="font-display text-base font-bold"
                            style=" font-weight:700; color:#F0F6F2;">
                            Roadmap Activity
                        </h3>
                        <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.45);">
                            Approved vs Pending per roadmap
                        </p>
                    </div>
                    <div style="height:220px;">
                        <div id="roadmapChart" style="width:100%; height:100%;"></div>
                    </div>
                    <div class="flex justify-around mt-4 text-xs">
                        <span class="flex items-center gap-1.5" style="color:rgba(255,255,255,0.55);">
                            <span class="w-2.5 h-2.5 rounded-sm" style="background:var(--color-primary);"></span>Approved
                        </span>
                        <span class="flex items-center gap-1.5" style="color:rgba(255,255,255,0.55);">
                            <span class="w-2.5 h-2.5 rounded-sm" style="background:#FCD34D;"></span>Pending
                        </span>
                    </div>
                </div>

            </div>
        </section>


        <!-- ── 4. SPECIALIZATIONS ── -->
        <section>
            <div class="glass-card p-6" style="border-radius:24px;">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="section-title flex items-center gap-2">
                            <i class="fa-solid fa-layer-group" style="color:#A78BFA; font-size:0.9rem;"></i>
                            Specializations
                        </h2>
                        <p class="text-xs mt-1" style="color:rgba(255,255,255,0.4);">
                            All available specializations on the platform
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs px-3 py-1 rounded-full font-semibold"
                              style="background:rgba(167,139,250,0.1); color:#A78BFA; border:1px solid rgba(167,139,250,0.2);">
                            <i class="fa-solid fa-hashtag text-xs mr-1"></i>
                            @ViewBag.SpecializationsTitles.Count Total
                        </span>
                    </div>
                </div>

                @if (ViewBag.SpecializationsTitles != null && ViewBag.SpecializationsTitles.Count > 0)
                {
                    <div class="flex flex-wrap gap-2.5">
                        @foreach (var name in ViewBag.SpecializationsTitles)
                        {
                            <span class="spec-tag">
                                <i class="fa-solid fa-circle-dot text-xs opacity-60"></i>
                                @name
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="flex flex-col items-center justify-center py-10 gap-3"
                         style="color:rgba(255,255,255,0.3);">
                        <i class="fa-solid fa-layer-group text-3xl opacity-30"></i>
                        <p class="text-sm">No specializations added yet</p>
                    </div>
                }
            </div>
        </section>


        <!-- ── 5. QUICK ACTIONS ── -->
        <section>
            <div class="flex items-center justify-between mb-4">
                <h2 class="section-title flex items-center gap-2">
                    <i class="fa-solid fa-bolt" style="color:#FCD34D; font-size:0.9rem;"></i>
                    Quick Actions
                </h2>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">

                <a asp-controller="Admin" asp-action="index" class="action-card">
                    <div class="action-icon"><i class="fa-solid fa-users"></i></div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Manage Users</span>
                </a>

                <a asp-controller="Admin" asp-action="ContributorRequests" class="action-card">
                    <div class="action-icon"
                         style="background:rgba(252,211,77,0.08); border-color:rgba(252,211,77,0.2); color:#FCD34D;">
                        <i class="fa-solid fa-user-clock"></i>
                    </div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Contributor Requests</span>
                </a>

                <a asp-controller="admin" asp-action="RoadmapRequests" class="action-card">
                    <div class="action-icon"
                         style="background:rgba(167,139,250,0.08); border-color:rgba(167,139,250,0.2); color:#A78BFA;">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Manage Roadmaps</span>
                </a>

                <a asp-controller="admin" asp-action="CourseRequests" class="action-card">
                    <div class="action-icon"
                         style="background:rgba(103,232,249,0.08); border-color:rgba(103,232,249,0.2); color:#67E8F9;">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Manage Courses</span>
                </a>

                <a asp-controller="Admin" asp-action="ContactMessages" class="action-card">
                    <div class="action-icon"
                         style="background:rgba(252,165,165,0.08); border-color:rgba(252,165,165,0.2); color:#FCA5A5;">
                        <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Contact Messages</span>
                </a>

                <a asp-controller="Admin" asp-action="Analytics" class="action-card">
                    <div class="action-icon"
                         style="background:rgba(52,211,153,0.08); border-color:rgba(52,211,153,0.2); color:var(--color-secondary);">
                        <i class="fa-solid fa-chart-mixed"></i>
                    </div>
                    <span class="text-sm font-medium" style="color:#E2E8F0;">Analytics</span>
                </a>

            </div>
        </section>


        <!-- ── 6. RECENT ACTIVITY + PENDING QUEUE ── -->
        <section class="grid grid-cols-1 lg:grid-cols-5 gap-4">

            <!-- Recent Activity -->
            <div class="glass-card p-6 lg:col-span-3">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="section-title flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left" style="color:var(--color-primary); font-size:0.9rem;"></i>
                        Recent Activity
                    </h2>
                    <a asp-controller="Admin" asp-action="ActivityLog"
                       class="text-xs font-medium hover:opacity-80 transition-opacity"
                       style="color:var(--color-primary);">
                        View all <i class="fa-solid fa-arrow-right ml-1 text-xs"></i>
                    </a>
                </div>

                <div>
                    <div class="activity-row">
                        <div class="activity-dot" style="  color:var(--color-primary);">
                            <i class="fa-solid fa-user-plus text-xs"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium" style="color:#E2E8F0;">New contributor request submitted</p>
                            <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.4);">Awaiting admin review &mdash; pending queue</p>
                        </div>
                        <span class="text-xs flex-shrink-0" style="color:rgba(255,255,255,0.35);">2 min ago</span>
                    </div>

                    <div class="activity-row">
                        <div class="activity-dot" style="background:rgba(252,211,77,0.1); color:#FCD34D;">
                            <i class="fa-solid fa-map text-xs"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium" style="color:#E2E8F0;">Roadmap waiting approval</p>
                            <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.4);">"Full-Stack Web Development" &mdash; submitted by contributor</p>
                        </div>
                        <span class="text-xs flex-shrink-0" style="color:rgba(255,255,255,0.35);">15 min ago</span>
                    </div>

                    <div class="activity-row">
                        <div class="activity-dot" style="background:rgba(103,232,249,0.1); color:#67E8F9;">
