<!-- ── CHARTS SCRIPTS ── -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

    // ── ① Donut Chart: User Distribution ──
    const studentCount     = @ViewBag.StudentCount;
    const contributorCount = @ViewBag.ContributorCount;
    const adminCount       = @ViewBag.AdminCount;

    new ApexCharts(document.querySelector("#usersChart"), {
    series: [studentCount, contributorCount, adminCount],
    chart: {
    type: "donut",
    height: 220,
    toolbar: { show: false },
    background: "transparent"
    },
    labels: ["Students", "Contributors", "Admins"],
    colors: ["var(--color-primary)", "#67E8F9", "#C084FC"],
    legend: { show: false },
    stroke: { width: 0 },
    dataLabels: { enabled: false },
    plotOptions: {
    pie: {
    donut: {
    size: "72%",
    labels: {
    show: true,
    total: {
    show: true,
    label: "Users",
    color: "#ffffff",
    formatter: () => studentCount + contributorCount + adminCount
    }
    }
    }
    }
    },
    tooltip: { theme: "dark" }
    }).render();

    // ── ② Bar Chart: Roadmap Approved vs Pending ──
    const roadmapData = @Html.Raw(Json.Serialize(ViewBag.RoadmapStatusData));

    const roadmapLabels  = roadmapData.map(r => r.title);
    const approvedValues = roadmapData.map(r => r.isApproved ? 1 : 0);
    const pendingValues  = roadmapData.map(r => r.isApproved ? 0 : 1);

    new ApexCharts(document.querySelector("#roadmapChart"), {
    series: [
    { name: "Approved", data: approvedValues },
    { name: "Pending",  data: pendingValues  }
    ],
    chart: {
    type: "bar",
    height: 220,
    stacked: true,
    toolbar: { show: false },
    background: "transparent"
    },
    colors: ["var(--color-primary)", "#FCD34D"],
    plotOptions: {
    bar: {
    horizontal: true,
    borderRadius: 5,
    borderRadiusApplication: "end"
    }
    },
    dataLabels: { enabled: false },
    xaxis: {
    categories: roadmapLabels,
    labels: { style: { colors: "#BDBDBD", fontSize: "11px" } },
    max: 1
    },
    yaxis: {
    labels: { style: { colors: "#D1D5DB", fontSize: "11px" } }
    },
    grid: { borderColor: "rgba(255,255,255,0.08)" },
    legend: { show: false },
    tooltip: { theme: "dark" }
    }).render();

    });
</script>
