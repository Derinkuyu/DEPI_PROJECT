@{
    ViewData["Title"] = "Home page";
}


    <!-- HERO -->
    <div class="hero">
        <div class="hero-left">
            <div class="hero-badge">THE FUTURE OF LEARNING</div>
            <h1>Learn Smarter<br>with <span class="accent">Structured</span><br>Roadmaps</h1>
            <p>Stop wasting time searching. Follow clear learning paths with curated resources, all in one place.</p>
            <div class="hero-btns">
                <a asp-action="Index" asp-controller="Roadmap"class="btn-explore">Explore Roadmaps</a>
            <a asp-controller="Authentication" asp-action="Register" class="btn-started">Get Started</a>
            </div>
        </div>
        <div class="hero-card">
            <div class="hc-header">
                <div class="hc-avatar">☁</div>
                <div class="hc-info">
                    <div class="hc-title">Cloud Architecture</div>
                    <div class="hc-sub">24 Steps • Mastery Level</div>
                </div>
                <div class="hc-dots">
                    <div class="hc-dot" style="background:#e05555"></div>
                    <div class="hc-dot" style="background:#e0a020"></div>
                    <div class="hc-dot" style="background:#40a060"></div>
                </div>
            </div>
            <div class="r-items">
                <div class="r-item done-item">
                    <div class="r-circle done">✓</div>
                    <div class="r-body">
                        <div class="r-name">Foundations of Cloud</div>
                        <div class="r-desc">Core concepts and service models</div>
                    </div>
                </div>
                <div class="r-item prog-item">
                    <div class="r-circle prog">●</div>
                    <div class="r-body">
                        <div class="r-name">Network Design</div>
                        <div class="r-prog-bar"><div class="r-prog-fill"></div></div>
                    </div>
                    <div class="r-badge">IN PROGRESS</div>
                </div>
                <div class="r-item lock-item">
                    <div class="r-circle lock">○</div>
                    <div class="r-body">
                        <div class="r-name">Security Best Practices</div>
                        <div class="r-desc">Identity management and encryption</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ROADMAPS -->
    <div class="roadmaps-section">
        <div class="sec-title">Explore Learning Roadmaps</div>
        <div class="sec-sub">Choose your path and start your journey step by step. Our curated tracks are<br>designed by industry experts to lead you to mastery.</div>
        <div class="rm-grid">
            <div class="rm-card c1">
                <div class="rm-icon">🖥</div>
                <h3>Frontend</h3>
                <p>Learn how to build modern user interfaces using HTML, CSS, and JavaScript.</p>
                <a href="#" class="rm-link">VIEW ROADMAP →</a>
            </div>
            <div class="rm-card c2">
                <div class="rm-icon">🗄</div>
                <h3>Backend</h3>
                <p>Understand server-side development, databases, and APIs to power the web.</p>
                <a href="#" class="rm-link">VIEW ROADMAP →</a>
            </div>
            <div class="rm-card c3">
                <div class="rm-icon">📱</div>
                <h3>Mobile</h3>
                <p>Create high-performance mobile apps using modern frameworks and tools.</p>
                <a href="#" class="rm-link">VIEW ROADMAP →</a>
            </div>
            <div class="rm-card c4">
                <div class="rm-icon">🤖</div>
                <h3>AI</h3>
                <p>Dive into artificial intelligence, machine learning, and data science.</p>
                <a href="#" class="rm-link">VIEW ROADMAP →</a>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="cta-wrap">
        <div class="cta-bar">
            <div>
                <h2>Can't decide?</h2>
                <p>Take our career assessment to find your perfect path.</p>
            </div>
            <button class="btn-assess">START ASSESSMENT</button>
        </div>
    </div>

    <!-- COURSES -->
    <div class="text-center" style="padding: 0 48px 16px; max-width:1060px; margin: 0 auto;">
        <div class="sec-title">Popular Courses</div>
        <div class="sec-sub">Step into the luminescent path of modern technology. Our curated courses<br>guide you through the digital nebula from fundamentals to mastery.</div>
    </div>
    <div class="courses-section">
        <div class="cr-grid">
            <div class="cr-card">
                <div class="cr-icon">💻</div>
                <h4>HTML Basics</h4>
                <p>Learn the foundation of web development with HTML.</p>
                <a href="#" class="cr-btn">Start Learning →</a>
            </div>
            <div class="cr-card">
                <div class="cr-icon">⚛</div>
                <h4>React Basics</h4>
                <p>Build dynamic user interfaces with React.</p>
                <a href="#" class="cr-btn">Start Learning →</a>
            </div>
            <div class="cr-card">
                <div class="cr-icon">🎨</div>
                <h4>CSS Fundamentals</h4>
                <p>Style and layout modern websites with CSS.</p>
                <a href="#" class="cr-btn">Start Learning →</a>
            </div>
            <div class="cr-card">
                <div class="cr-icon">⚙</div>
                <h4>JavaScript Essentials</h4>
                <p>Add interactivity and logic to your web apps.</p>
                <a href="#" class="cr-btn">Start Learning →</a>
            </div>
            <div class="cr-card">
                <div class="cr-icon">⚛</div>
                <h4>React Basics</h4>
                <p>Build dynamic user interfaces with React.</p>
                <a href="#" class="cr-btn">Start Learning →</a>
            </div>
        </div>
    </div>

    <!-- WHY -->
    <div class="why-section">
        <div class="why-left">
            <div class="why-mini">
                <div class="wm-top"><span class="wm-icon">✓</span><span class="wm-label">COMPLETED</span></div>
                <div class="wm-val">Web Architect</div>
            </div>
            <div class="why-mini">
                <div class="wm-top"><span class="wm-icon">↗</span><span class="wm-label">PROGRESS</span></div>
                <div class="wm-val">Expert Level</div>
            </div>
            <div class="why-mini">
                <div class="wm-top"><span class="wm-icon">🚀</span><span class="wm-label">WITH</span></div>
                <div class="wm-val">Fast-Track</div>
            </div>
            <div class="why-mini">
                <div class="wm-top"><span class="wm-icon">👥</span><span class="wm-label">COMMUNITY</span></div>
                <div class="wm-val">12k Students</div>
            </div>
        </div>
        <div class="why-right">
            <h2>Why Choose StuMap?</h2>
            <div class="why-item">
                <div class="wi-icon">🔗</div>
                <div class="wi-text">
                    <h4>Non-Linear Learning</h4>
                    <p>Unlike traditional platforms, we offer flexible roadmaps that adapt to your specific goals and existing knowledge.</p>
                </div>
            </div>
            <div class="why-item">
                <div class="wi-icon">✦</div>
                <div class="wi-text">
                    <h4>Luminescent Insights</h4>
                    <p>Gain clarity through deep-dive sessions and real-world project scenarios designed for immediate application.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTACT -->
    <div class="contact-section">
        <div class="sec-title">Have Questions? Get in Touch!</div>
        <div class="sec-sub">Whether you're looking for technical support, mentorship opportunities,<br>or corporate training solutions, our team is here to guide your path.</div>
        <div class="ct-cards">
            <div class="ct-card">
                <div class="ct-icon">✉</div>
                <h4>Email</h4>
                <p>contact@yourdomain.com</p>
            </div>
            <div class="ct-card">
                <div class="ct-icon">📞</div>
                <h4>Phone</h4>
                <p>+1 (123) 456-7890</p>
            </div>
            <div class="ct-card">
                <div class="ct-icon">↗</div>
                <h4>Follow Us</h4>
                <div class="soc-row">
                    <div class="soc-btn">G</div>
                    <div class="soc-btn">in</div>
                    <div class="soc-btn">X</div>
                    <div class="soc-btn">yt</div>
                </div>
            </div>
        </div>
    </div>

