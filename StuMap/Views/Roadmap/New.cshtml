    <div class="dropdown">
        <div tabindex="0" role="button" class="btn w-full">
            <input type="text" placeholder="Search for a course" id="course-search" onkeyup="filterFunction()" class="focus:outline-0 w-full" />
            </div>
       
        <ul id="courses-dropdown"  tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm w-full">
            @foreach (var course in ViewBag.courses)
            {
                <li class="w-full">
                    <a> @course.Title <div class="badge badge-soft badge-accent"> <i class="fa-regular fa-user"></i>@course.Contributor.FirstName @course.Contributor.LastName</div></a>
                    
                    </li>
            }
        </ul>
    </div>
</section>
