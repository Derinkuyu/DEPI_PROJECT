@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@* can be removed ^*@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StuMap</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
        
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/StuMap.styles.css" asp-append-version="true" /> *@
</head>
<body>

    <div class="nav-wrap">
        <nav class="nav">
            <a href="/" class="nav-logo">StuMap</a>
            <div class="nav-links">
                <a href="#">Home</a>
                <a href="#">Roadmaps</a>
                <a href="#">Courses</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </div>
            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn-ghost-custom btn-ghost">@User.FindFirst("FirstName")?.Value @User.FindFirst("LastName")?.Value</div>
                        <ul tabindex="-1"
                            class="menu dropdown-content bg-base-200 rounded-box z-1 mt-4 w-52 p-2 shadow-sm">
                            <li>
                                <a asp-controller="Account"
                                       asp-action="Edit">
                                    Account
                                </a>
                            </li>
                            @if (User.IsInRole("Student"))
                            {
                                <li><a asp-controller="Student" asp-action="GetEnrolledCourses">My Courses</a></li>
                                <li><a asp-controller="Student" asp-action="GetEnrolledRoadmaps">My Roadmaps</a></li>
                            }
                            <li>
                                <a asp-controller="Authentication"
                                       asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="nav-item">
                        <a asp-controller="Authentication"
                               asp-action="Logout"
                               class="btn-signup btn btn-primary btn-sm">
                            Logout
                        </a>
                    </div>
                }
                else
                {
                    <a asp-controller="Authentication" asp-action="Login" class="btn-ghost-custom btn-ghost">Login</a>
                    <a asp-controller="Authentication" asp-action="Register" class="btn-signup btn btn-primary btn-sm">Register</a>
                }
            </div>
        </nav>
    </div>
    <main role="main">
        @RenderBody()
    </main>
    <footer>
        <div>
            <div class="f-logo">StuMap</div>
            <div class="f-sub">Building the world's most accessible architecture for lifelong learning.</div>
        </div>
        <div class="f-links">
            <div class="f-col">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
            </div>
            <div class="f-col">
                <a href="#">Cookie Policy</a>
                <a href="#">Support</a>
            </div>
        </div>
        <div class="f-copy">© 2026 StuMap Learning Architecture. All rights reserved.</div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
