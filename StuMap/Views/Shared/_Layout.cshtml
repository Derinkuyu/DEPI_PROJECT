@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StuMap</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    @* <link rel="stylesheet" href="~/StuMap.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <header>
        <div class="navbar bg-base-100 shadow-sm">
            <div class="navbar-start">
                <a href="/" class="btn btn-ghost text-xl">StuMap</a>
            </div>

            <div class="navbar-end">
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-outline rounded-field">@User.FindFirst("FirstName")?.Value @User.FindFirst("LastName")?.Value</div>
                        <ul tabindex="-1"
                            class="menu dropdown-content bg-base-200 rounded-box z-1 mt-4 w-52 p-2 shadow-sm">
                            <li>
                                <a asp-controller="Account"
                                       asp-action="Edit">
                                    Account
                                </a>
                            </li>
                            <li><a>Profile</a></li>
                            <li>
                                <a asp-controller="Authentication"
                                       asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="nav-item">
                        <a asp-controller="Authentication"
                               asp-action="Logout"
                               class="nav-link btn btn-link border-0">
                            Logout
                        </a>
                    </div>
                }
                else
                {
                    <div class="nav-item">
                        <a class="nav-link " asp-controller="Authentication" asp-action="Login">Login</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - StuMap - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
