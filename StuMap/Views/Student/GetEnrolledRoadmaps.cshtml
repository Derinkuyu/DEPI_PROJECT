@model List<Roadmap>

<section class="mx-6 my-8 ">
    <div class="flex flex-col justify-center items-center">
        <p class="text-4xl font-semibold ">My Roadmaps</p>
    </div>

    @if (!Model.Any())
    {
        <div class="flex flex-col justify-center items-center mt-12">
            <p class="text-2xl text-primary-content">You are not enrolled in any roadmaps yet.</p>
            <a asp-controller="Roadmap"
                   asp-action="Index"
                   class="btn btn-primary text-base-content  rounded-full flex items-center justify-center gap-2 h-12">
                Explore Roadmaps
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-10 w-full my-4">

            @foreach (var roadmap in Model)
            {
                <div class="card w-96 bg-base-2 00 border-1 border-neutral card-lg shadow-sm w-full transition duration-300 ease-in-out hover:shadow-lg dark:hover:shadow-white/30">
                    <div class="card-body flex flex-col gap-3">
                        <div class="badge badge-primary uppercase">@roadmap.Specialization.Name</div>
                        <p class="text-3xl card-title font-normal">@roadmap.Title</p>
                        <p class="text-l text-primary-content-para  w-200 ">@roadmap.Description</p>
                        <div class="flex items-baseline">
                            <div class="badge badge-soft badge-success px-6 py-4"> <i class="fa-solid fa-graduation-cap"></i> @roadmap.CourseRoadmaps.Count() Courses</div>
                            <div class="uppercase ml-4 text-primary-content-para  tracking-widest text-sm">
                                <i class="fa-regular fa-user"></i> @roadmap.Contributor.FirstName @roadmap.Contributor.LastName
                            </div>
                        </div>

						<!-- Buttons -->
                        <div class="flex gap-2 items-center w-full mt-auto">
                            
                            <!--Details-->
                            <a asp-action="Details"
                                asp-controller="Roadmap"
                                asp-route-id="@roadmap.Id" 
                                class="btn btn-outline btn-primary rounded-full btn-lg hover:bg-linear-(--gradient-btn)">
                            View Roadmap
                            </a>
                            
                            <!--Delete-->
                            <a asp-controller="Student"
                                   asp-action="RemoveRoadmap"
                                   asp-route-id="@roadmap.Id"
                                   class="btn btn-neutral btn-outline rounded-full w-12 h-12 flex items-center justify-center">
                                ✕
                            </a>
                        
                        </div>
                    </div>
                </div>
            }
        </div>
        
    }

</section>